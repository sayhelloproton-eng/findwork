{
  "name": "findwork",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node app/server/server.ts",
    "demo": "node app/server/server.ts --demo",
    "jobs": "node app/server/job-cli.ts",
    "build:ui": "node scripts/build-antd.mjs",
    "test": "node --test --test-concurrency=1 app/tests/job-store.public.test.ts app/tests/public-app.public.test.ts app/tests/public-seed.public.test.ts",
    "verify:extension": "npm --prefix platforms/boss/extension run verify",
    "verify": "npm run build:ui && npm test && npm run verify:extension && node scripts/verify-repo.mjs && node scripts/audit-public.mjs",
    "prestart": "npm run build:ui",
    "test:browser": "node --test app/tests/job-browser.public.test.ts"
  },
  "dependencies": {
    "antd": "6.6.7",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
