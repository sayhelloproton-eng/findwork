{
  "name": "findwork",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node app/server/server.ts",
    "demo": "node app/server/server.ts --demo",
    "jobs": "node app/server/job-cli.ts",
    "build:ui": "vite build",
    "test": "node --test --test-concurrency=1 app/tests/*.public.test.* skills/job-search/test/*.test.mjs",
    "verify:extension": "npm --prefix platforms/boss/extension run verify",
    "verify": "npm run build:ui && npm test && npm run verify:extension && node scripts/verify-repo.mjs && node scripts/audit-public.mjs",
    "prestart": "npm run build:ui",
    "test:browser": "node --test app/tests/job-browser.test.ts",
    "dev:ui": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "antd": "6.6.7",
    "echarts": "6.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "0.28.2",
    "vite": "^8.3.5"
  }
}
